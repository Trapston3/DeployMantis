# Port Configuration
STRATA_PORT=3002
MANTIS_ENV_PORT=8000
CORE_API_PORT=4000
STRATA_BUFFER_SIZE=50

# ── BYOM: Bring Your Own Model ────────────────────────────────
# Override the default Ollama model used by the LLM gateway.
# Examples: mistral, codellama, phi3, gemma2, llama3.2
CUSTOM_MODEL_NAME=llama3.2

# Inference provider: "ollama" (local) or "huggingface" (cloud)
INFERENCE_PROVIDER=ollama
